load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "php2go_lib",
    srcs = ["main.go"],
    importpath = "github.com/moriyoshi/php2go/cmd/php2go",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/bundlebuild",
        "//internal/ir",
        "//internal/ir/irpb",
        "//internal/zend",
    ],
)

go_binary(
    name = "php2go",
    embed = [":php2go_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "php2go_test",
    srcs = ["main_test.go"],
    embed = [":php2go_lib"],
)
