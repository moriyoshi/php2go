        "incdec_test.go",
        "share_test.go",
        "superglobals_test.go",
        "throwable_test.go",
        "value_test.go",
    ],
    # The catalogue tests read the runtime's own sources: they check that every
    # variant names a function that exists and that its binding shape is
    # described. Reading the source is the point, so the sources are data.
    data = [
        "array.go",
        "coerce.go",
        "incdec.go",
        "intrinsics.go",
        "iter.go",
        "ops.go",
        "//internal/gogen:gogen.go",
