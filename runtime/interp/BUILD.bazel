load("@rules_go//go:def.bzl", "go_library", "go_test")

# The interpreter reads serialized IR and needs no PHP build, so it runs
# anywhere Go does. Only its differential test links the engine.
go_library(
    name = "interp",
    srcs = [
        "abstract.go",
        "arrayaccess.go",
        "arrayobject.go",
        "autoload.go",
        "builtins.go",
        "call.go",
        "callback.go",
        "class.go",
        "closure.go",
        "constants.go",
        "constexpr.go",
        "cycles.go",
        "deprecated.go",
        "enum.go",
        "errorhandler.go",
        "fiber.go",
        "filteriterator.go",
        "gc.go",
        "generator.go",
        "hooks.go",
        "image.go",
        "incdec.go",
        "include.go",
        "interp.go",
        "introspect.go",
        "lazy.go",
        "locals.go",
        "magic.go",
        "mathlib.go",
        "networklib.go",
        "outputrewrite.go",
        "program.go",
        "random.go",
        "realpath.go",
        "property.go",
        "reflectdump.go",
        "reflection.go",
        "scalars.go",
        "sensitive.go",
        "serialize.go",
        "signature.go",
		"source_render.go",
        "streams.go",
        "streamwrappers.go",
        "streamfilters.go",
        "strings.go",
        "throw.go",
        "ticks.go",
        "traits.go",
        "types.go",
        "userland.go",
        "weak.go",
    ],
    importpath = "github.com/moriyoshi/php2go/runtime/interp",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/ir/irpb",
        "//runtime/libc",
        "//runtime/php",
        "//runtime/stdlib",
        "@org_golang_google_protobuf//proto",
    ],
)

go_test(
    name = "interp_test",
    srcs = [
        "differential_test.go",
        "interp_test.go",
    ],
    deps = [
        ":interp",
        "//internal/ir",
        "//internal/ir/irpb",
        "//internal/userland",
        "//internal/zend",
        "//runtime/php",
    ],
)
