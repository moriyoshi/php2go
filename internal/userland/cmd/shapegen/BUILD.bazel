load("@rules_go//go:def.bzl", "go_binary", "go_test")

go_binary(
    name = "shapegen",
    srcs = ["main.go"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/userland",
        "//runtime/php",
        "//runtime/stdlib",
    ],
)

go_test(
    name = "shapegen_test",
    srcs = [
        "main.go",
        "main_test.go",
    ],
    data = ["//internal/userland:shape.tsv"],
    deps = [
        "//internal/userland",
        "//runtime/php",
        "//runtime/stdlib",
    ],
)
