module(
    name = "php2go",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")

# sh_binary is no longer a builtin global.
bazel_dep(name = "rules_shell", version = "0.8.0")

bazel_dep(name = "rules_go", version = "0.63.0")

bazel_dep(name = "gazelle", version = "0.53.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.5")

# Go module dependencies are read from go.mod, so ordinary `go build` and Bazel
# resolve to the same versions.
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "org_golang_google_protobuf")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

# Generator tools are built from source inside the graph rather than taken from
# PATH, so a build depends on nothing but Bazel and a C toolchain. m4 is here
# because bison shells out to it at run time, not merely to build.
_ALL_FILES = """\
filegroup(
    name = "all",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
"""

http_archive(
    name = "m4_src",
    build_file_content = _ALL_FILES,
    sha256 = "63aede5c6d33b6d9b13511cd0be2cac046f2e70fd0a07aa9573a04a82783af96",
    strip_prefix = "m4-1.4.19",
    urls = ["https://ftp.gnu.org/gnu/m4/m4-1.4.19.tar.xz"],
)

http_archive(
    name = "bison_src",
    build_file_content = _ALL_FILES,
    sha256 = "9bba0214ccf7f1079c5d59210045227bcf619519840ebfa80cd3849cff5a5bf2",
    strip_prefix = "bison-3.8.2",
    urls = ["https://ftp.gnu.org/gnu/bison/bison-3.8.2.tar.xz"],
)

http_archive(
    name = "re2c_src",
    build_file_content = _ALL_FILES,
    sha256 = "ffea067c11aa668bcb42885be6e6cd000302000b7747d2bb213299ec66b7864e",
    strip_prefix = "re2c-4.5.1",
    urls = ["https://github.com/skvadrik/re2c/releases/download/4.5.1/re2c-4.5.1.tar.xz"],
)

# php-src stays a pristine submodule; its build file is generated by Reforge and
# lives here rather than being written into the checkout.
new_local_repository(
    name = "php",
    build_file = "//third_party:php.BUILD.bazel",
    path = "third_party/php-src",
)
